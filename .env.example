# FLASK CONFIGURATION
FLASK_ENV=production
SECRET_KEY=your-super-secret-production-key
PORT=5000
HOST=0.0.0.0

# APP OPTIMIZATIONS
ENABLE_XLA=True
ENABLE_CACHING=True

# MODEL CONFIGURATION (Must match the architecture of best_htr_model.h5)
IMAGE_WIDTH=128
IMAGE_HEIGHT=32
MAX_TEXT_LENGTH=32
VOCAB_SIZE=80

# UPLOAD CONSTRAINTS
MAX_CONTENT_LENGTH=16777216
